@baseUrl = http://localhost:5000/api

### LOGIN (AUTH WORKING)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Password123!"
}

### CREATE VEHICLE
POST {{baseUrl}}/vehicles
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY5NjNjNWU5Mzk0OTBhYmRjZmE1MWM1OSIsInJvbGUiOiJhZG1pbiIsImlhdCI6MTc2ODE2MDI5MCwiZXhwIjoxNzY4MTYzODkwfQ.oKNWXBlmB4_0wh99us5jTdsJNFItvXmCM-auv15xRCs
Content-Type: application/json

{
  "vin": "2HGCM822233A00998",
  "licensePlate": "TN-09-2116",
  "make": "Honda2",
  "model": "City6",
  "year": 2021
}

### LIST VEHICLES (PAGINATION + AUTH)
GET {{baseUrl}}/vehicles?page=1&limit=5
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY5NjNjNWU5Mzk0OTBhYmRjZmE1MWM1OSIsInJvbGUiOiJhZG1pbiIsImlhdCI6MTc2ODE2MDI5MCwiZXhwIjoxNzY4MTYzODkwfQ.oKNWXBlmB4_0wh99us5jTdsJNFItvXmCM-auv15xRCs


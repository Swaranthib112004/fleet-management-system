### ASSIGN DRIVER TO VEHICLE
POST {{baseUrl}}/drivers/assign
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY5NjNjNWU5Mzk0OTBhYmRjZmE1MWM1OSIsInJvbGUiOiJhZG1pbiIsImlhdCI6MTc2ODE1Mzc2NiwiZXhwIjoxNzY4MTU3MzY2fQ.HYtfb_SG1xNF4-2yi-U15asBbWXhh4FlMarCVGiyDPo
Content-Type: application/json


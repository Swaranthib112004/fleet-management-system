  "documents": {
    "create": {
      "endpoint": "POST /api/uploads",
      "contentType": "multipart/form-data",
      "fields": {
        "file": "binary file data",
        "vehicleId": "optional - link to vehicle",
        "driverId": "optional - link to driver",
        "type": "optional - insurance, registration, maintenance, inspection"
      },
      "curlExample": "curl -X POST http://localhost:8000/api/uploads -H 'Authorization: Bearer {token}' -F 'file=@/path/to/document.pdf' -F 'vehicleId=VEHICLE_ID' -F 'type=insurance'"
    }
  },

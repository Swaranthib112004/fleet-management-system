    "authentication": "Always include 'Authorization: Bearer {token}' header in all requests",
    "timestamps": "Use ISO 8601 format: YYYY-MM-DDTHH:mm:ssZ",
    "ids": "Replace ID placeholders (VEHICLE_ID_HERE, DRIVER_ID_HERE, etc) with actual MongoDB ObjectIDs",
    "responses": "200 = Success, 400 = Bad Request, 401 = Unauthorized, 404 = Not Found, 500 = Server Error",
